# Finomix KMS configuration. Copy to /etc/kms/kms.env, fill in, then:
#   chown root:kms /etc/kms/kms.env && chmod 0640 /etc/kms/kms.env
#
# Read by BOTH the systemd unit and the interactive CLI (see deploy/kmsctl).
# An empty value counts as UNSET — the built-in default is applied instead.

# ---- storage -------------------------------------------------------------
# SQLite with WAL, so this is really three files (kms.db, -wal, -shm). Back it
# up with `sqlite3 kms.db ".backup ..."`, never by copying kms.db alone.
KMS_DB_PATH=/var/lib/kms/kms.db

# Admin/control plane. A unix socket, not a TCP port: 0600 kms:kms, so only the
# kms user (and root) can unseal, rotate or break-glass.
KMS_ADMIN_SOCKET=/run/kms/admin.sock

# ---- data plane ----------------------------------------------------------
# REQUIRED for `serve`. Passed verbatim to http.Server.Addr — there is no
# separate bind-address setting, so this must be the full host:port.
#
# Bind the PRIVATE IP only. The address here, the argument you gave
# scripts/gen-pki.sh, and the host in the app's KMS_URL must all be the same IP:
# the server certificate carries an IP SAN and no DNS SAN, so a hostname fails
# verification.
#
# Port must be >= 1024 — the unit drops all capabilities.
KMS_LISTEN_ADDR=10.0.0.3:8443

# ---- mTLS ----------------------------------------------------------------
# All three are required for `serve`.
KMS_TLS_SERVER_CERT=/etc/kms/kms-server.crt
KMS_TLS_SERVER_KEY=/etc/kms/kms-server.key
# CA used to verify the CLIENT chain (app-server), not our own cert.
KMS_TLS_CLIENT_CA=/etc/kms/ca.crt

# sha256 of the app-client certificate, printed by scripts/gen-pki.sh.
# At least one pin is mandatory: `serve` refuses to start without a valid one,
# and the value must normalise to exactly 64 hex characters.
#
# ⚠ The pin covers the WHOLE DER certificate, not the public key — reissuing a
# leaf changes the pin even if you reuse the keypair. For zero-downtime renewal,
# list both pins comma-separated, deploy the new client cert, then drop the old:
#   KMS_TLS_CLIENT_PINS=<old>,<new>
KMS_TLS_CLIENT_PINS=

# ---- limits --------------------------------------------------------------
# Token bucket per company_id, applied to both generate and unwrap; burst equals
# the full per-minute value.
#
# ⚠ A non-integer or a value < 1 makes EVERY command fail — including `status`
# and `verify-audit` — because config parsing runs before command dispatch.
#
# Note there is no DEK cache on the app side, so every DEK operation is a round
# trip. A company doing heavy bulk invoicing can reach this ceiling.
KMS_RATE_LIMIT_UNWRAP_PER_MIN=120

# 1 = call mlockall() so key material never reaches swap. Requires
# LimitMEMLOCK=infinity in the unit. Failure is only a warning — verify with
# `journalctl -u kms | grep -i 'mlock failed'`.
KMS_MLOCK=1
